#!/usr/bin/env bash
# Pre-commit hook: scan staged content for secrets before allowing a commit.
# Activate in a fresh clone with: git config core.hooksPath .githooks
set -eu

red() { printf '\033[31m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged_files" ] && exit 0

# Named patterns: "<label>|<ERE regex>"
patterns=(
  'Tavily API key|tvly-[A-Za-z0-9_-]{10,}'
  'Anthropic API key|sk-ant-[A-Za-z0-9_-]{20,}'
  'OpenAI API key|sk-[A-Za-z0-9]{32,}'
  'GitHub token|gh[pousr]_[A-Za-z0-9]{30,}'
  'GitHub fine-grained PAT|github_pat_[A-Za-z0-9_]{40,}'
  'AWS access key ID|AKIA[0-9A-Z]{16}'
  'Slack token|xox[abprs]-[A-Za-z0-9-]{10,}'
  'Google API key|AIza[0-9A-Za-z_-]{35}'
  'Replicate token|r8_[A-Za-z0-9]{30,}'
  'Private key block|-----BEGIN ([A-Z ]+ )?PRIVATE KEY-----'
)

found=0
while IFS= read -r file; do
  [ -z "$file" ] && continue
  [ ! -f "$file" ] && continue
  # Skip lockfiles and binaries (git grep respects binary detection)
  case "$file" in
    *.lock|package-lock.json|pnpm-lock.yaml|yarn.lock) continue ;;
  esac

  for entry in "${patterns[@]}"; do
    label="${entry%%|*}"
    regex="${entry#*|}"
    if matches=$(git diff --cached -U0 -- "$file" | grep -E "^\+" | grep -En "$regex" 2>/dev/null); then
      if [ $found -eq 0 ]; then
        red "✗ Pre-commit: потенциальные секреты в staged-изменениях"
        echo
      fi
      found=1
      yellow "  $file — $label"
      echo "$matches" | sed 's/^/      /'
    fi
  done
done <<< "$staged_files"

if [ $found -ne 0 ]; then
  echo
  red "Коммит отклонён. Убери секрет, вынеси в .env (он в .gitignore) и перезапусти commit."
  echo "Если срочно нужен обход — git commit --no-verify (не рекомендуется)."
  exit 1
fi

exit 0
