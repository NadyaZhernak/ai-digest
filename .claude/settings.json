{
    "permissions": {
        "allow": [
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git push *)",
            "Write(content/**)",
            "Write(public/covers/**)",
            "Edit(content/**)",
            "mcp__tavily__*",
            "mcp__replicate__*"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path' | xargs npx prettier --write 2>/dev/null; exit 0"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous.sh\""
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                {
                    "type": "command",
                    "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-article.sh\""
                }
                ]
            }
        ]
    }
}